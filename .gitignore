.DS_Store
**/.DS_Store

# >>> cc-suite >>>
# AI assistant local state
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/*.local.*
CLAUDE.local.md

# Codex CLI — local files, keep checked-in subdirs
.codex/*
!.codex/skills/
!.codex/prompts/
!.codex/hooks.json
!.codex/hooks.cc-suite.json
!.codex/config.toml

# Gemini CLI — local files, keep checked-in subdirs
.gemini/*
!.gemini/skills/
!.gemini/commands/
# <<< cc-suite <<<

# nlpm generated artifacts
.claude/nlpm-history.json

# source-ledger verification secrets — API keys, NEVER commit
.secrets*
!.secrets.env.template
book/evidence/source-ledger/.verify-log.json
book/evidence/source-ledger/.verify-run*.log
book/evidence/source-ledger/.content-audit.json
book/evidence/source-ledger/.content-audit.log

# scheduled-tasks local lock for /loop and ScheduleWakeup
.claude/scheduled_tasks.lock

# source-ledger personal verification archive — owner's saved PDFs/epubs/txt of
# verified sources. Contains licensed/copyrighted material (NYT articles,
# epubs of monographs, etc.) — personal verification copies, never redistribute.
book/evidence/source-ledger/human-verification-files/
book/evidence/source-ledger/.DS_Store

# cc-suite plugin-cache symlink — regenerated by /cc-suite:bridge-skills on each machine
.claude/skills/cc-suite
.venv/
pipelines/print/node_modules/
pipelines/print/out/
pipelines/print/package-lock.json
pipelines/design-studio/out/

# dist/ — derived output. Treat manuscript as a CACHE, not source:
# pipelines/epub/build_kdp_epub.py auto-regenerates it from
# book/chapters-v6/ + book/spine-v6.yml + book/{front,back}-matter/
# whenever it's stale. Never commit it; never trust a "manuscript" file
# to be authoritative. Authority lives in book/. See RELEASE-PREP.md.
__pycache__/
*.pyc
.DS_Store

# (EPUB, interior+cover PDF, assembled manuscript). Everything else

# dist/ is derived/sellable output — never in the repo. Build locally; editions sold on KDP.
dist/
translation-pipeline-template/
