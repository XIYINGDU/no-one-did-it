# Source-ledger verification API keys.
#
# Copy this file to `.secrets.env` (which is gitignored) and fill in the values.
# Load before running the verifier:   set -a; source .secrets.env; set +a
#
# All keys below are FREE except PACER (pay-per-page, optional).
# See the acquisition guide printed by the assistant, or book/evidence/source-ledger/README.md.

# ── api.data.gov (one key covers BOTH congress.gov and govinfo.gov) ──
# Get at: https://api.data.gov/signup/   (instant; emailed key, 40 chars)
DATA_GOV_API_KEY=

# ── CourtListener (free court opinions + RECAP dockets) ──
# Get at: https://www.courtlistener.com/profile/api-token/  (after free signup)
# Format: a 40-char hex token. Used as  Authorization: Token <token>
COURTLISTENER_TOKEN=

# ── Internet Archive Save-Page-Now v2 (authenticated Wayback capture) ──
# Get at: https://archive.org/account/s3.php  (after free archive.org signup)
# Two values: an access key and a secret key. Used as  Authorization: LOW <access>:<secret>
ARCHIVE_ORG_ACCESS_KEY=
ARCHIVE_ORG_SECRET_KEY=

# ── PACER (OPTIONAL — only for sealed federal dockets not on RECAP) ──
# Pay-per-page (~$0.10/page, capped ~$3/doc, waived under $30/quarter).
# Get at: https://pacer.uscourts.gov/register-account
# Leave blank unless a specific sealed docket needs it.
PACER_USERNAME=
PACER_PASSWORD=
